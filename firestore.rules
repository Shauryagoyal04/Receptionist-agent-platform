rules_version = '2';

/*
 * The browser never queries Firestore in this app. Every read and write goes
 * through the Admin SDK on the server (lib/data/*), which bypasses these rules
 * by design.
 *
 * These rules therefore exist as a backstop, not as the primary control: if
 * someone later adds a client-side query, it fails closed instead of quietly
 * exposing every patient conversation in the clinic.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user may read their own profile. Nothing more, and never
    // anyone else's — role and clinicId are authorization inputs, so letting
    // the client rewrite them would be a privilege escalation.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Patient conversations and their transcripts. Server-only, without
    // exception.
    match /conversations/{conversationId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    // Clinic settings and any future daily analytics rollups (see §10 of the
    // build plan) are likewise server-only.
    match /clinics/{clinicId} {
      allow read, write: if false;
    }

    match /analyticsDaily/{docId} {
      allow read, write: if false;
    }

    // Anything not named above is denied. Listed explicitly so that adding a
    // new collection is a deliberate act rather than an accidental opening.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
