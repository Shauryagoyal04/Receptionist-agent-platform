# ---------------------------------------------------------------------------
# MongoDB
#
# The SAME database the AI agent writes to. The console owns the
# `conversations` collection plus the Auth.js `users` / `accounts` /
# `sessions` collections, and reads the agent's `appointments`, `doctors`,
# `patients` and `clinic` collections.
#
# Atlas: Database → Connect → Drivers. Remember to allow your IP.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=clinic

# ---------------------------------------------------------------------------
# Auth.js
#
# AUTH_SECRET signs the session cookie. Generate one with:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=

# Google sign-in. Leave both blank to hide the Google button entirely.
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: https://your-domain/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local development)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required in production only: the canonical origin, e.g. https://console.example.com
# AUTH_URL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
DEFAULT_CLINIC_ID=main-clinic
DEFAULT_CLINIC_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Capabilities
#
# Voice and human handoff are fully modelled in the schema and data layer, so
# enabling them later is a config change here rather than a migration.
# ---------------------------------------------------------------------------

# Channels this deployment can actually produce. The channel column, filter
# and analytics card only appear once more than one is listed.
#   whatsapp                     — today
#   whatsapp,voice               — when the voice agent ships
ENABLED_CHANNELS=whatsapp

# Does a human actually pick up when a patient asks for one?
#
# false does NOT mean patients stop asking — the agent still offers to pass
# them to a person. It means nobody is notified, so the console presents those
# conversations as an outstanding follow-up queue ("Asked for a human")
# instead of as something already handled ("Escalated"), and hides the
# "Resolved without a human" KPI, which is pinned at 100% without a handoff.
HUMAN_HANDOFF_ENABLED=false

# Comma-separated email domains allowed to sign up, e.g. "hospital.example".
# Leave empty to allow any domain (logged as a warning at boot).
SIGNUP_ALLOWED_DOMAINS=

# Bearer token the AI agent presents to POST /api/ingest/conversation.
# Generate with: openssl rand -hex 32
INGEST_API_KEY=
