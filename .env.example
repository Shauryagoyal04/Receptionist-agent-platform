# ---------------------------------------------------------------------------
# MongoDB
#
# The SAME database the AI agent writes to. The console owns the
# `conversations` collection plus the Auth.js `users` / `accounts` /
# `sessions` collections, and reads the agent's `appointments`, `doctors`,
# `patients` and `clinic` collections.
#
# Atlas: Database → Connect → Drivers. Remember to allow your IP.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=clinic

# ---------------------------------------------------------------------------
# Auth.js
#
# AUTH_SECRET signs the session cookie. Generate one with:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=

# Google sign-in. Leave both blank to hide the Google button entirely.
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: https://your-domain/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local development)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required in production only: the canonical origin, e.g. https://console.example.com
# AUTH_URL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
DEFAULT_CLINIC_ID=main-clinic
DEFAULT_CLINIC_TIMEZONE=Asia/Kolkata

# Comma-separated email domains allowed to sign up, e.g. "hospital.example".
# Leave empty to allow any domain (logged as a warning at boot).
SIGNUP_ALLOWED_DOMAINS=

# Bearer token the AI agent presents to POST /api/ingest/conversation.
# Generate with: openssl rand -hex 32
INGEST_API_KEY=
